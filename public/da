



<!-- Application JavaScript Logic -->
    <script>
        // --- Configuration Constants ---
        const STORAGE_KEY = 'app_chat_session_v1';
        const THEME_KEY = 'app_theme_mode';
        const SESSION_EXPIRY_MS = 24 * 60 * 60 * 1000; // 24 Hours in milliseconds

        // --- DOM Elements ---
        const chatForm = document.getElementById("chat-form");
        const userInput = document.getElementById("user-input");
        const chatBox = document.getElementById("chat-box");
        const sendBtn = document.getElementById("send-btn");
        const themeToggleBtn = document.getElementById("theme-toggle");
        const darkIcon = document.getElementById("theme-toggle-dark-icon");
        const lightIcon = document.getElementById("theme-toggle-light-icon");
        const clearHistoryBtn = document.getElementById("clear-history-btn");
        const newChatBtn = document.getElementById("new-chat-btn");
        const sessionTitlePreview = document.getElementById("session-title-preview");
        const sessionTime = document.getElementById("session-time");

        // Mobile Sidebar Controls
        const sidebar = document.getElementById("sidebar");
        const sidebarBackdrop = document.getElementById("sidebar-backdrop");
        const openSidebarMobile = document.getElementById("open-sidebar-mobile");
        const closeSidebarMobile = document.getElementById("close-sidebar-mobile");

        // App Session State
        let sessionData = {
            timestamp: Date.now(),
            messages: []
        };

        // --- Theme Toggle Logic ---
        function initTheme() {
            const savedTheme = localStorage.getItem(THEME_KEY);
            const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

            if (savedTheme === "dark" || (!savedTheme && systemPrefersDark)) {
                document.documentElement.classList.add("dark");
                lightIcon.classList.remove("hidden");
                darkIcon.classList.add("hidden");
            } else {
                document.documentElement.classList.remove("dark");
                darkIcon.classList.remove("hidden");
                lightIcon.classList.add("hidden");
            }
        }

        themeToggleBtn.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            localStorage.setItem(THEME_KEY, isDark ? "dark" : "light");
            darkIcon.classList.toggle("hidden", isDark);
            lightIcon.classList.toggle("hidden", !isDark);
        });

        // --- Sidebar Mobile Controls ---
        function toggleMobileSidebar(open) {
            if (open) {
                sidebar.classList.remove("-translate-x-full");
                sidebarBackdrop.classList.remove("hidden");
            } else {
                sidebar.classList.add("-translate-x-full");
                sidebarBackdrop.classList.add("hidden");
            }
        }
        openSidebarMobile.addEventListener("click", () => toggleMobileSidebar(true));
        closeSidebarMobile.addEventListener("click", () => toggleMobileSidebar(false));
        sidebarBackdrop.addEventListener("click", () => toggleMobileSidebar(false));

        // --- Session Storage & Persistence (24 Hour Auto Expiry) ---
        function loadSession() {
            try {
                const rawData = localStorage.getItem(STORAGE_KEY);
                if (rawData) {
                    const parsed = JSON.parse(rawData);
                    const now = Date.now();

                    // Check if 24 hours have elapsed
                    if (now - parsed.timestamp < SESSION_EXPIRY_MS) {
                        sessionData = parsed;
                    } else {
                        // Expired: reset session
                        clearSession();
                        return;
                    }
                }
            } catch (e) {
                console.error("Failed to parse local chat history", e);
            }

            // Default welcome message if empty
            if (!sessionData.messages || sessionData.messages.length === 0) {
                sessionData.messages = [
                    {
                        role: "model",
                        text: "Halo! Saya adalah asisten virtual Anda. Ada yang bisa saya bantu hari ini?",
                        time: formatTime(new Date())
                    }
                ];
                saveSession();
            }

            renderAllMessages();
        }

        function saveSession() {
            sessionData.timestamp = Date.now();
            localStorage.setItem(STORAGE_KEY, JSON.stringify(sessionData));
            updateSidebarPreview();
        }

        function clearSession() {
            localStorage.removeItem(STORAGE_KEY);
            sessionData = {
                timestamp: Date.now(),
                messages: [
                    {
                        role: "model",
                        text: "Halo! Sesi obrolan baru telah dimulai. Ada yang bisa saya bantu?",
                        time: formatTime(new Date())
                    }
                ]
            };
            saveSession();
            renderAllMessages();
        }

        function formatTime(dateObj) {
            return new Date(dateObj).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function updateSidebarPreview() {
            const userMessages = sessionData.messages.filter(m => m.role === 'user');
            if (userMessages.length > 0) {
                const lastUserText = userMessages[userMessages.length - 1].text;
                sessionTitlePreview.textContent = lastUserText;
            } else {
                sessionTitlePreview.textContent = "Sesi Baru";
            }
            if (sessionData.messages.length > 0) {
                const lastMsg = sessionData.messages[sessionData.messages.length - 1];
                sessionTime.textContent = lastMsg.time || 'Baru';
            }
        }

        // --- Render Messages UI ---
        function createMessageElement(role, text, timeText) {
            const wrapper = document.createElement("div");
            const isUser = role === "user";

            wrapper.className = isUser
                ? "flex flex-col items-end max-w-[85%] sm:max-w-[75%] ml-auto"
                : "flex flex-col items-start max-w-[85%] sm:max-w-[75%]";

            // Bubble
            const bubble = document.createElement("div");
            bubble.className = isUser
                ? "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 px-4 py-2.5 rounded-2xl rounded-tr-xs text-sm shadow-sm leading-relaxed break-words w-full"
                : "bg-slate-100 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/50 text-slate-800 dark:text-slate-100 px-4 py-2.5 rounded-2xl rounded-tl-xs text-sm shadow-sm leading-relaxed break-words prose dark:prose-invert w-full";

            if (isUser) {
                bubble.textContent = text;
            } else {
                // Safely render Markdown for Bot
                if (window.marked) {
                    bubble.innerHTML = marked.parse(text);
                } else {
                    bubble.textContent = text;
                }
            }

            // Time Metadata
            const meta = document.createElement("span");
            meta.className = "text-[10px] text-slate-400 dark:text-slate-500 mt-1 px-1";
            meta.textContent = timeText || formatTime(new Date());

            wrapper.appendChild(bubble);
            wrapper.appendChild(meta);

            return { wrapper, bubble };
        }

        function renderAllMessages() {
            chatBox.innerHTML = "";
            sessionData.messages.forEach(msg => {
                const { wrapper } = createMessageElement(msg.role, msg.text, msg.time);
                chatBox.appendChild(wrapper);
            });
            chatBox.scrollTop = chatBox.scrollHeight;
            updateSidebarPreview();
        }

        function appendMessage(role, text) {
            const currentTime = formatTime(new Date());
            const msgObj = { role, text, time: currentTime };
            
            sessionData.messages.push(msgObj);
            saveSession();

            const { wrapper, bubble } = createMessageElement(role, text, currentTime);
            chatBox.appendChild(wrapper);
            chatBox.scrollTop = chatBox.scrollHeight;

            return bubble;
        }

        // --- Textarea Auto Expand ---
        userInput.addEventListener("input", () => {
            userInput.style.height = "auto";
            userInput.style.height = Math.min(userInput.scrollHeight, 128) + "px";
        });

        userInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                chatForm.dispatchEvent(new Event("submit"));
            }
        });

        // --- Chat Form Handling & API Logic ---
        chatForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const userText = userInput.value.trim();
            if (!userText) return;

            // 1. Reset Input Height and Value
            userInput.value = "";
            userInput.style.height = "auto";
            userInput.disabled = true;
            sendBtn.disabled = true;

            // 2. Append User Message
            appendMessage("user", userText);

            // 3. Show Bot Thinking Indicator
            const { wrapper: thinkingWrapper, bubble: botBubble } = createMessageElement("model", "...", formatTime(new Date()));
            botBubble.classList.add("animate-pulse", "text-slate-400");
            chatBox.appendChild(thinkingWrapper);
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                // Prepare conversation payload formatted for server endpoint
                const payload = sessionData.messages.map(m => ({
                    role: m.role,
                    text: m.text
                }));

                const response = await fetch("/api/chat", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                        conversation: payload,
                    }),
                });

                chatBox.removeChild(thinkingWrapper);

                if (!response.ok) {
                    throw new Error(`Server status: ${response.status}`);
                }

                const data = await response.json();
                const botReply = (data && data.result) ? data.result : "Tidak ada respon dari server.";
                
                appendMessage("model", botReply);

            } catch (error) {
                console.error("Chat Error:", error);
                if (chatBox.contains(thinkingWrapper)) {
                    chatBox.removeChild(thinkingWrapper);
                }
                appendMessage("model", "Maaf, terjadi masalah saat menghubungkan ke server.");
            } finally {
                userInput.disabled = false;
                sendBtn.disabled = false;
                userInput.focus();
            }
        });

        // --- Clear & New Chat Handlers ---
        clearHistoryBtn.addEventListener("click", () => {
            if (confirm("Apakah Anda yakin ingin menghapus seluruh riwayat obrolan?")) {
                clearSession();
            }
        });

        newChatBtn.addEventListener("click", () => {
            clearSession();
            toggleMobileSidebar(false);
        });

        document.getElementById("mock-attach").addEventListener("click", () => {
            alert("Fitur lampiran file siap diintegrasikan.");
        });

        // --- Initial Load ---
        window.addEventListener("DOMContentLoaded", () => {
            initTheme();
            loadSession();
        });
    </script>